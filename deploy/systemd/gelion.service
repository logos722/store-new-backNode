[Unit]
Description=Gelion store
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/gelion
ExecStart=/usr/bin/docker compose --env-file images.env -f compose.yml up -d --wait --wait-timeout 180
ExecStop=/usr/bin/docker compose --env-file images.env -f compose.yml stop
TimeoutStartSec=240
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
